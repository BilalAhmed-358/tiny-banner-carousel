{
  "name": "tiny-banner-carousel",
  "version": "0.1.0",
  "description": "A lightweight, accessible banner carousel for React",
  "main": "./dist/index.cjs",
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "react",
    "banner",
    "carousel",
    "slider",
    "slideshow",
    "swipe",
    "autoplay",
    "typescript",
    "lightweight"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
